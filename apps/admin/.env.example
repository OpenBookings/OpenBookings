# OpenBookings: admin console (apps/admin)
#
#   cp apps/admin/.env.example apps/admin/.env.local
#
# Local only: it binds to 127.0.0.1:3005 and is never built or deployed.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/openbookings
DATABASE_URL_DIRECT=postgres://postgres:postgres@127.0.0.1:5433/openbookings
STRIPE_SECRET_KEY=sk_test_replace_me

# Which database DATABASE_URL is, for the invoice pages: "production" or "test".
INVOICE_DB_ENV=test
# The private bucket commission invoices are read from.
# R2_INVOICES_BUCKET_NAME=

# "1" enables super-admin actions. Only honoured with NODE_ENV=development.
# ADMIN_SUPER_MODE=1
