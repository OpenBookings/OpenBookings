# OpenBookings: support bot (apps/support-bot)
#
#   cp apps/support-bot/.env.example apps/support-bot/.env.local
#
# Runs on http://localhost:3003. It answers Chatwoot webhooks, so you need a
# Chatwoot account to use it. At startup it checks that every variable its
# configuration needs is set, and refuses to start otherwise.

# --- Required ---------------------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/openbookings
STRIPE_SECRET_KEY=sk_test_replace_me

# The language model (Mistral).
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Chatwoot: the instance, the account, and the agent bot's token and webhook secret.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_ACCESS_TOKEN=
CHATWOOT_BOT_WEBHOOK_SECRET=
# Guest inboxes with identity validation (HMAC) set to mandatory, comma-separated.
# Only there does the bot trust a guest's email to look up their bookings.
CHATWOOT_VERIFIED_INBOX_IDS=

# This service's own public URL (where Chatwoot and the task queue reach it).
SERVICE_BASE_URL=http://localhost:3003

# --- Task dispatch ----------------------------------------------------------

# Locally: run tasks in-process, with no queue and no signature checks.
# TASKS_AUTH_DISABLED is only accepted when SERVICE_BASE_URL is a local address.
TASKS_INLINE=true
TASKS_AUTH_DISABLED=true
# Deployed: Upstash QStash.
# QSTASH_URL=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# --- Host support (optional) -----------------------------------------------

# Turns on the host-support inbox. Needs the four variables below.
SUPPORT_CHAT_ENABLED=false
SUPPORT_ASSISTANT_ENABLED=false
# CHATWOOT_BUSINESS_INBOX_ID=
# CHATWOOT_ACCOUNT_WEBHOOK_SECRET=
# BUSINESS_APP_URL=http://business.localhost:3001
# LETTERMINT_PROJECT_TOKEN=

# Refunds above this amount (EUR) go to a human instead of the bot.
# REFUND_ESCALATION_THRESHOLD_EUR=
# EMAIL_FROM_ADDRESS="OpenBookings <noreply@example.com>"
