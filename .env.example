# OpenBookings: root environment
#
# Copy to `.env.local` (git-ignored) and fill in what you need.
#
#   cp .env.example .env.local
#
# Read by the scripts that run from the repository root or load
# ../../.env.local: packages/db (drizzle-kit), packages/demo (demo:reset) and
# apps/invoice-job. Each Next.js app and the support bot read their own file:
# see apps/<app>/.env.example.
#
# Full reference: apps/docs/content/docs/self-hosted/reference/environment-variables.mdx

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Postgres 17 with PostGIS. The local test database from testing/ is:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/openbookings
# A direct (non-pooled) connection, for migrations and long transactions.
# On Neon: the host without "-pooler". Locally: the same as DATABASE_URL.
DATABASE_URL_DIRECT=postgres://postgres:postgres@127.0.0.1:5433/openbookings

# Optional: ENV_TYPE=dev makes packages/db and drizzle-kit use DEV_DATABASE_URL
# instead of DATABASE_URL.
# ENV_TYPE=dev
# DEV_DATABASE_URL=

# Optional pool tuning (defaults shown). See packages/db/README.md.
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=240000
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_IDLE_TX_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Testing mode
# ---------------------------------------------------------------------------

# TESTING=true together with an sk_test_ key turns on demo hotels and lets
# demo:reset run. Refused with a live key.
TESTING=true
STRIPE_SECRET_KEY=sk_test_replace_me

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# "console" prints emails to the terminal instead of sending them (local
# development only; refused in production). Leave it unset to send through
# Lettermint.
EMAIL_TRANSPORT=console
# LETTERMINT_PROJECT_TOKEN=
# EMAIL_FROM_ADDRESS="OpenBookings <noreply@example.com>"

# ---------------------------------------------------------------------------
# Invoice job (apps/invoice-job). Only needed to run it. See its README.
# ---------------------------------------------------------------------------

# Which database DATABASE_URL is: exactly "production" or "test". A test key
# needs "test", a live key needs "production".
# INVOICE_DB_ENV=test
# The platform's own VAT number, sent with every VIES check.
# VIES_REQUESTER_VAT=NL000000000B01
# Where the run report is emailed after a real (not dry) draft run.
# INVOICE_REPORT_EMAIL=
# Test mode only: every invoice email goes to this one address.
# INVOICE_TEST_RECIPIENT=
# Optional: Slack incoming webhook for run summaries and alerts.
# SLACK_WEBHOOK_URL=
# Optional: error reporting.
# SENTRY_DSN=
# Invoice PDFs and CSVs (Cloudflare R2 or any S3-compatible store).
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_INVOICES_BUCKET_NAME=
