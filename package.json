{
  "name": "openbookings",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "testing"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "testing:db": "bun run --cwd testing db:up",
    "testing:setup": "bun run --cwd testing setup",
    "testing:down": "bun run --cwd testing db:down",
    "knip": "knip --include dependencies,unlisted,unresolved,binaries"
  },
  "devDependencies": {
    "@openbookings/config": "workspace:*",
    "@openbookings/db": "workspace:*",
    "knip": "6.45.0",
    "turbo": "2.11.10"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@xmldom/xmldom": "^0.8.15",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1"
  }
}
