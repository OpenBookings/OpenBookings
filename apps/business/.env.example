# OpenBookings: host dashboard (apps/business)
#
#   cp apps/business/.env.example apps/business/.env.local
#
# Runs on http://business.localhost:3001. Use the *.localhost names, not plain
# localhost: the guest and host apps keep their cookies apart that way.
#
# Full reference: apps/docs/content/docs/self-hosted/reference/environment-variables.mdx

# --- Required ---------------------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/openbookings
DATABASE_URL_DIRECT=postgres://postgres:postgres@127.0.0.1:5433/openbookings

NEXT_PUBLIC_BUSINESS_URL=http://business.localhost:3001
NEXT_PUBLIC_WEB_URL=http://web.localhost:3002

# Better Auth. Use a different secret from apps/web: openssl rand -base64 32
AUTH_BASE_URL=http://business.localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must be ob-host here and ob-guest in apps/web.
AUTH_COOKIE_PREFIX=ob-host

# Stripe, test mode. The connected-account webhook and the platform webhook
# each have their own signing secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_replace_me

# --- Local development -----------------------------------------------------

# Every host who signs in also owns the demo organisation (needs an sk_test_ key).
TESTING=true
# Print emails, sign-in links included, to this terminal instead of sending them.
EMAIL_TRANSPORT=console
# The publish/booking readiness gate (Stripe account, legal details, billing
# profile, ...). Set to "off" to switch it off locally. The seeded hotels in
# testing/ pass it without this.
# PROPERTY_READINESS_ENFORCE=off

# --- Photo uploads (needed to upload property and room photos) --------------

# Cloudflare R2 or any S3-compatible bucket, and the public URL it serves from.
# `bun run --cwd apps/business scripts/check-storage.ts` checks the setup.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_BASE_URL=
# The private bucket commission invoices are stored in.
# R2_INVOICES_BUCKET_NAME=

# --- Optional ---------------------------------------------------------------

# Sending email for real (when EMAIL_TRANSPORT is unset).
# LETTERMINT_PROJECT_TOKEN=
# EMAIL_FROM_ADDRESS="OpenBookings <noreply@example.com>"

# Google sign-in for hosts (a separate OAuth client from the guest site's).
# GOOGLE_CLIENT_ID_BUSINESS=
# GOOGLE_CLIENT_SECRET_BUSINESS=

# Map for placing the property pin (https://www.maptiler.com).
# NEXT_PUBLIC_MAPTILER_API_KEY=
# NEXT_PUBLIC_MAPTILER_STYLE_ID=

# Cache (Upstash Redis). Off when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Live guest-host messaging (see apps/web/.env.example).
# REALTIME_WORKER_URL=
# NEXT_PUBLIC_REALTIME_WORKER_URL=
# REALTIME_TOKEN_SECRET=
# REALTIME_SERVICE_SECRET=
# MESSAGE_RETENTION_DAYS=

# Scheduled jobs (Bearer auth on /api/cron/*) and how long booking notes are
# kept before the PII-retention job clears them.
# CRON_SECRET=
# PII_RETENTION_MONTHS=

# Refreshing a public property page after a host edits it: the guest site's
# revalidate secret, and optionally a Cloudflare cache purge.
# REVALIDATE_SECRET=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_PURGE_TOKEN=

# VIES checks of EU VAT numbers: the platform's own VAT number.
# VIES_REQUESTER_VAT=

# Sign-in risk scoring (Tirreno). Off when unset.
# TIRRENO_URL=
# TIRRENO_API_KEY=

# Host support chat (Chatwoot). See apps/support-bot.
# SUPPORT_CHAT_ENABLED=false
# SUPPORT_ASSISTANT_ENABLED=false
# NEXT_PUBLIC_CHATWOOT_BASE_URL=
# CHATWOOT_ACCOUNT_ID=
# CHATWOOT_BUSINESS_INBOX_IDENTIFIER=
# CHATWOOT_BUSINESS_INBOX_HMAC_TOKEN=
# CHATWOOT_BOT_ACCESS_TOKEN=

# Analytics and error reporting. Off when unset.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_COOKIE_VERSION=1
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
