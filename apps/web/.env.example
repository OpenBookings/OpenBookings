# OpenBookings: guest site (apps/web)
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Runs on http://web.localhost:3002. Use the *.localhost names, not plain
# localhost: the guest and host apps keep their cookies apart that way.
#
# Full reference: apps/docs/content/docs/self-hosted/reference/environment-variables.mdx

# --- Required ---------------------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/openbookings

NEXT_PUBLIC_WEB_URL=http://web.localhost:3002
NEXT_PUBLIC_BUSINESS_URL=http://business.localhost:3001

# Better Auth. The secret must be at least 32 characters: openssl rand -base64 32
AUTH_BASE_URL=http://web.localhost:3002
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must be ob-guest here and ob-host in apps/business.
AUTH_COOKIE_PREFIX=ob-guest

# Stripe, test mode. Keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# From `stripe listen --forward-to web.localhost:3002/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Local development -----------------------------------------------------

# Demo hotels and test-only behaviour (needs an sk_test_ key).
TESTING=true
# Print emails, sign-in links included, to this terminal instead of sending them.
EMAIL_TRANSPORT=console
# A test-mode connected account that checkout at demo hotels charges on
# (ignored in production).
STRIPE_CONNECT_ACCOUNT_ID=
# Take the 4.5% commission as a Stripe application fee. Off until set to "true".
STRIPE_APPLICATION_FEE_ENABLED=false

# --- Checkout bot protection (needed to complete a checkout) ----------------

# Cloudflare Turnstile. Create a free widget with web.localhost as a hostname.
# Checkout refuses every token unless the secret and the hostnames are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=web.localhost

# --- Optional ---------------------------------------------------------------

# Sending email for real (when EMAIL_TRANSPORT is unset).
# LETTERMINT_PROJECT_TOKEN=
# EMAIL_FROM_ADDRESS="OpenBookings <noreply@example.com>"

# Social sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Maps on search and property pages (https://www.maptiler.com).
# NEXT_PUBLIC_MAPTILER_API_KEY=
# NEXT_PUBLIC_MAPTILER_STYLE_ID=

# Cache for property pages and reviews (Upstash Redis). Off when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Live guest-host messaging through the realtime worker. Without it, messages
# still save; they just don't push live.
# REALTIME_WORKER_URL=
# NEXT_PUBLIC_REALTIME_WORKER_URL=
# REALTIME_TOKEN_SECRET=
# REALTIME_SERVICE_SECRET=
# MESSAGE_RETENTION_DAYS=

# Shared secrets for the scheduled jobs (Bearer auth on /api/cron/*) and for
# the business app asking this app to refresh a property page.
# CRON_SECRET=
# REVALIDATE_SECRET=

# Analytics and error reporting. Off when unset.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_COOKIE_VERSION=1
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
