{
  "name": "@openbookings/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local drizzle-kit migrate",
    "db:migrate:ci": "bun scripts/migrate-ci.ts",
    "db:push": "bun --env-file=../../.env.local drizzle-kit push",
    "db:setup:ci": "bun scripts/apply-schema-ci.ts",
    "db:studio": "bun --env-file=../../.env.local drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@openbookings/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^5.9.3"
  }
}
