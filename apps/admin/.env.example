# OpenBookings: admin console (apps/admin)
#
#   cp apps/admin/.env.example apps/admin/.env.local
#
# Local only: it binds to 127.0.0.1:3005 and is never built or deployed.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/openbookings
DATABASE_URL_DIRECT=postgres://postgres:postgres@127.0.0.1:5433/openbookings

# Production, least privilege (migration 0054): set these instead of a
# full-access DATABASE_URL. Pages read through READ (ob_admin_read, SELECT
# only); actions write through WRITE (ob_admin_write). READ alone makes the
# console read-only. Neither set: DATABASE_URL for both. Setting up the login
# users: apps/docs/content/docs/self-hosted/reference/environment-variables.mdx.
# ADMIN_DATABASE_URL_READ=postgresql://admin_reader:<password>@<host>/neondb?sslmode=require
# ADMIN_DATABASE_URL_WRITE=postgresql://admin_writer:<password>@<host>/neondb?sslmode=require
# Outside production only sk_test_ / rk_test_ keys are accepted for real actions; production allows the live key.
STRIPE_SECRET_KEY=sk_test_replace_me

# Which database DATABASE_URL is, for the invoice pages: "production" or "test".
INVOICE_DB_ENV=test
# The private bucket commission invoices are read from.
# R2_INVOICES_BUCKET_NAME=

# "1" enables super-admin actions. Only honoured with NODE_ENV=development.
# ADMIN_SUPER_MODE=1

# Step-up (/security): passkeys and authenticator apps for dangerous actions.
# ADMIN_TOTP_KEY encrypts authenticator-app secrets: openssl rand -base64 32
# ADMIN_TOTP_KEY=
# A staff member's first passkey or authenticator app needs this code; later
# ones need a step-up. Unset: nobody can add a first one.
# ADMIN_BOOTSTRAP_CODE=
# Passkeys' host name. Required in production; unset in development: the request's host.
# ADMIN_RP_ID=admin.openbookings.co
