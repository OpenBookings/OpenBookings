{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@types/geojson"],
  "ignoreIssues": {
    "apps/*/components/ui/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@openbookings/config", "@openbookings/db"]
    },
    "apps/*": {
      "entry": ["scripts/**/*.ts"]
    },
    "packages/*": {
      "entry": ["scripts/**/*.ts"]
    },
    "packages/db": {
      "drizzle": false,
      "entry": ["scripts/**/*.ts", "seed/**/*.ts", "drizzle.config.ts"]
    }
  }
}
