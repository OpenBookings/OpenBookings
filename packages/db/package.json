{
  "name": "@openbookings/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./booking-lifecycle": "./src/booking-lifecycle/index.ts",
    "./testing": "./src/testing/db-harness.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.local drizzle-kit migrate",
    "db:migrate:ci": "bun scripts/migrate-ci.ts",
    "db:apply-pending:ci": "bun scripts/apply-pending-ci.ts",
    "db:push": "bun --env-file=../../.env.local drizzle-kit push",
    "db:setup:ci": "bun scripts/apply-schema-ci.ts",
    "db:studio": "bun --env-file=../../.env.local drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@openbookings/pricing": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@openbookings/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^5.9.3"
  }
}
