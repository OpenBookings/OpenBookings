{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "minimumReleaseAge": "3 days",
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Safe minors: every minor and patch update in one weekly PR, auto-merged once CI is green. Excludes the framework group and the packages that always need a human (rules below).",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "*",
        "!next",
        "!@next/**",
        "!eslint-config-next",
        "!react",
        "!react-dom",
        "!@types/react",
        "!@types/react-dom",
        "!better-auth",
        "!@better-auth/**",
        "!drizzle-orm",
        "!drizzle-kit",
        "!stripe",
        "!hono",
        "!@mistralai/mistralai",
        "!typescript"
      ],
      "groupName": "safe minors",
      "schedule": ["before 6am on monday"],
      "automerge": true
    },
    {
      "description": "Framework: Next, React and their types move together in one PR as soon as a release is 3 days old (these often carry security fixes). Never auto-merged.",
      "matchPackageNames": [
        "next",
        "@next/**",
        "eslint-config-next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "framework",
      "automerge": false
    },
    {
      "description": "Never auto-merge — security, DB, payments, and framework core need a human",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "better-auth",
        "@better-auth/**",
        "drizzle-orm",
        "drizzle-kit",
        "stripe",
        "hono",
        "@mistralai/mistralai",
        "typescript"
      ],
      "automerge": false
    },
    {
      "description": "Majors: one PR per package, opened only after it is ticked on the Dependency Dashboard, never auto-merged",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "@types/node follows the Node runtime (22: engines.node and the Dockerfile builders), not the newest Node. Raise together with the runtime.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    }
  ]
}
