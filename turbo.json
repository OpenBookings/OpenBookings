{
  "$schema": "https://v2-10-2.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "CI", "NEXT_PUBLIC_*", "SENTRY_AUTH_TOKEN"],
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_DIRECT"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      // Turbo's default envMode is strict, so a task sees only what it
      // declares. The ARI availability suite talks to the Postgres service
      // container CI provisions, and skips when DATABASE_URL is absent --
      // unless CI is set, where a missing database is a broken pipeline.
      "env": ["CI"],
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_DIRECT"]
    }
  }
}
