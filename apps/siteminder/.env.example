# OpenBookings: SiteMinder app (apps/siteminder)
#
#   cp apps/siteminder/.env.example apps/siteminder/.env.local
#
# Optional: only needed when hotels connect SiteMinder. Runs on http://localhost:3004
# (`bun run dev`; the docs site uses that port too). At startup it checks that every
# required variable is set, and refuses to start otherwise. See src/env.ts, and the
# README for running it locally against a fake core or end to end.

# --- Required ---------------------------------------------------------------

# The app's own database (tables in schema `siteminder`), never core's shared one.
# `bun run db:migrate` applies its migrations.
SITEMINDER_DATABASE_URL=postgres://postgres:pw@127.0.0.1:55432/siteminder

# Credentials SiteMinder presents when it calls us (ours to choose and give them).
SITEMINDER_INBOUND_USERNAME=
SITEMINDER_INBOUND_PASSWORD=
# SiteMinder's reservation endpoint, the credentials and the channel code they issue.
SITEMINDER_RESERVATION_URL=
SITEMINDER_RESERVATION_USERNAME=
SITEMINDER_RESERVATION_PASSWORD=
SITEMINDER_REQUESTOR_ID=

# Bearer secret core uses to register installations: the same value as
# APP_SITEMINDER_REGISTRATION_SECRET in apps/business.
APP_SITEMINDER_REGISTRATION_SECRET=
# Bearer secret for POST /tick (the outside scheduler in scale-to-zero).
SITEMINDER_TICK_SECRET=

# --- Optional ---------------------------------------------------------------

# always-on (polls every SITEMINDER_POLL_SECONDS, default 60) or scale-to-zero
# (default; an outside scheduler calls POST /tick, polls at most every 300 s).
# SITEMINDER_RUN_MODE=scale-to-zero
# SITEMINDER_POLL_SECONDS=

# The doorbell from core, through Upstash QStash. Unset, /doorbell answers 503 and
# polling still delivers. SERVICE_BASE_URL must equal core's APP_SITEMINDER_URL.
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# SERVICE_BASE_URL=
